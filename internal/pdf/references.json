{
  "license": "PolyForm-Noncommercial-1.0.0",
  "schema": "breachsafe.pdf.references/v1",
  "rules": [
    {
      "match": ["hybrid.negotiated", "hybrid.pq", "pure_pq"],
      "cwe": "",
      "refs": [],
      "fix": ""
    },
    {
      "match": ["probe_failed"],
      "cwe": "",
      "refs": ["Coverage gap"],
      "fix": "Re-scan to confirm post-quantum support."
    },
    {
      "match": ["aggressive"],
      "cwe": "CWE-327",
      "refs": ["RFC 9395", "NIST SP 800-77 Rev 1"],
      "fix": "Disable IKEv1 aggressive mode; migrate to IKEv2."
    },
    {
      "match": ["ike.v1", "ikev1"],
      "cwe": "CWE-327",
      "refs": ["RFC 9395", "NIST SP 800-77 Rev 1"],
      "fix": "Migrate the gateway to IKEv2 (RFC 9370 for PQ)."
    },
    {
      "match": ["dh.weak", "dh_weak"],
      "cwe": "CWE-326",
      "refs": ["RFC 8247", "NIST SP 800-56A"],
      "fix": "Remove weak Diffie-Hellman groups."
    },
    {
      "match": ["downgrade", "classical.negotiated", "classical.protocol"],
      "cwe": "CWE-757",
      "refs": ["NIST IR 8547", "OWASP WSTG (weak TLS)"],
      "fix": "Prefer a hybrid group; remove the classical downgrade path (Open Quantum Safe oqs-provider)."
    },
    {
      "match": ["legacy"],
      "cwe": "CWE-327",
      "refs": ["NIST SP 800-52 Rev 2", "RFC 8996"],
      "fix": "Disable TLS 1.0/1.1; serve TLS 1.3."
    },
    {
      "match": ["cert"],
      "cwe": "CWE-327",
      "refs": ["FIPS 204 (ML-DSA)", "FIPS 205 (SLH-DSA)"],
      "fix": "Track the post-quantum certificate roadmap."
    },
    {
      "match": ["classical"],
      "cwe": "CWE-327",
      "refs": ["NIST IR 8547", "FIPS 203 (ML-KEM)", "CNSA 2.0"],
      "fix": "Enable a hybrid post-quantum key exchange (Open Quantum Safe oqs-provider)."
    }
  ],
  "resources": [
    {"name": "NIST IR 8547 — Transition to Post-Quantum Cryptography Standards", "url": "https://csrc.nist.gov/pubs/ir/8547/ipd"},
    {"name": "FIPS 203 — ML-KEM (key encapsulation)", "url": "https://csrc.nist.gov/pubs/fips/203/final"},
    {"name": "FIPS 204 — ML-DSA (signatures)", "url": "https://csrc.nist.gov/pubs/fips/204/final"},
    {"name": "FIPS 205 — SLH-DSA (hash-based signatures)", "url": "https://csrc.nist.gov/pubs/fips/205/final"},
    {"name": "NIST SP 800-52 Rev 2 — TLS configuration", "url": "https://csrc.nist.gov/pubs/sp/800/52/r2/final"},
    {"name": "NIST SP 800-131A Rev 2 — transitioning algorithm strengths", "url": "https://csrc.nist.gov/pubs/sp/800/131/a/r2/final"},
    {"name": "NIST SP 800-77 Rev 1 — Guide to IPsec VPNs", "url": "https://csrc.nist.gov/pubs/sp/800/77/r1/final"},
    {"name": "NSA CNSA 2.0 — Commercial National Security Algorithm Suite", "url": "https://www.nsa.gov/Press-Room/News-Highlights/Article/Article/3148990/"},
    {"name": "RFC 9395 — Deprecation of IKEv1", "url": "https://www.rfc-editor.org/info/rfc9395"},
    {"name": "RFC 8996 — Deprecating TLS 1.0 and TLS 1.1", "url": "https://www.rfc-editor.org/info/rfc8996"},
    {"name": "RFC 8247 — IKEv2 algorithm requirements", "url": "https://www.rfc-editor.org/info/rfc8247"},
    {"name": "RFC 9370 — Multiple Key Exchanges in IKEv2", "url": "https://www.rfc-editor.org/info/rfc9370"},
    {"name": "OWASP Top 10:2025 A04 — Cryptographic Failures", "url": "https://owasp.org/Top10/2025/A04_2025-Cryptographic_Failures/"},
    {"name": "OWASP WSTG — Testing for Weak Transport Layer Security", "url": "https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/09-Testing_for_Weak_Cryptography/01-Testing_for_Weak_Transport_Layer_Security"},
    {"name": "MITRE CWE-757 — Algorithm Downgrade", "url": "https://cwe.mitre.org/data/definitions/757.html"},
    {"name": "MITRE CWE-327 — Broken or Risky Cryptographic Algorithm", "url": "https://cwe.mitre.org/data/definitions/327.html"},
    {"name": "MITRE CWE-326 — Inadequate Encryption Strength", "url": "https://cwe.mitre.org/data/definitions/326.html"},
    {"name": "Open Quantum Safe — oqs-provider (hybrid PQ for OpenSSL/TLS)", "url": "https://github.com/open-quantum-safe/oqs-provider"}
  ]
}
